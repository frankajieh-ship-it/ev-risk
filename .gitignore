# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Next.js build output — never commit compiled artifacts
.next/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Local Netlify folder
.netlify

# Pattern tracking data (user-submitted behavioral patterns)
/data/patterns.json

# Generated ETL output files (data_v2/) — large, regenerated from scripts/etl/
# Run scripts/etl/*.ts to regenerate. Do NOT commit these files.
/data_v2/vehicle_master.json
/data_v2/recalls_live.json
/data_v2/charger_density_v2.json
/data_v2/electricity_rates.json
/data_v2/market_pricing.json
